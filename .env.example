# contoh config — copy ke .env lalu isi
HOST=127.0.0.1
PORT=20140

# sandi login web (isi dengan sha256 dari sandi pilihanmu)
# cara bikin: node -e "console.log(require('crypto').createHash('sha256').update('sandimu').digest('hex'))"
LOGIN_SHA256=

# sandi admin untuk HAPUS sesi (boleh kosong = hapus terbuka)
ADMIN_PASS=

# kunci internal API (otomatis dibuat saat pertama jalan kalau kosong)
GATEWAY_KEY=

# --- anti-abuse (sesuaikan) ---
MAX_POOL=10
CREATE_PER_DAY=1
PREM_COOLDOWN=60

# --- auth provider (PRIVATE, tidak dipublish) ---
# versi publik pakai stub lib/auth.js — 4 fungsi di bawah diimplementasikan
# di versi private sesuai penyedia auth masing-masing:
# PROVIDER_API_KEY=
# PROVIDER_VERIFY_URL=
# PROVIDER_PRODUCT_ID=
